{
  "name": "logo-label",
  "widthMm": 100,
  "heightMm": 50,
  "dpi": 203,
  "elements": [
    { "type": "image", "x": 6, "y": 6, "data": "{{logo}}", "widthMm": 30, "threshold": 128 },
    { "type": "text", "x": 42, "y": 8, "text": "{{company}}", "heightMm": 6 },
    { "type": "text", "x": 42, "y": 18, "text": "{{tagline}}", "heightMm": 4 },
    { "type": "barcode", "symbology": "code128", "x": 6, "y": 30, "data": "{{code}}", "heightMm": 12 }
  ]
}
